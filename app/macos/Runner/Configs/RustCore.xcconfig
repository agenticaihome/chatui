// The Rust core (rust/crates/wallet-ffi) for macOS on Apple Silicon: a static library that
// scripts/build_macos.sh builds in the first build phase of Runner ("Build the Rust core").
// -force_load keeps every function of the bridge in the app, although no Swift code calls
// them: Dart finds them in the process (ExternalLibrary.process in lib/services/rust_library.dart).
//
// Apple Silicon only (issue #154): no x86_64 part, no universal binary.
ARCHS = arm64
EXCLUDED_ARCHS = x86_64
MACOSX_DEPLOYMENT_TARGET = 13.0

RUST_CORE_LIB = $(PROJECT_DIR)/../../rust/target/aarch64-apple-darwin/release/libwallet_ffi.a
// The system libraries of the crates (cargo rustc -- --print native-static-libs).
OTHER_LDFLAGS = $(inherited) -force_load "$(RUST_CORE_LIB)" -framework Security -framework SystemConfiguration -framework CoreFoundation -liconv -lresolv -lc++
